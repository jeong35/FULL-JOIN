# 계정 로그인(이메일 회원가입 + 카카오·구글·애플). 이 파일을 .env.local 로 복사해서 값을 채운다(.env.local은 깃에 안 올라감).
# 세 값이 다 있어야 켜지고, 하나라도 비면 예전 로그인(닉네임 + 숫자 4자리) 그대로다.
# ANON_KEY는 Supabase 대시보드 → Project Settings → API 의 공개 키(anon)다. service_role 키는 절대 넣지 않는다.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_AUTH_PROVIDERS=email,kakao,google
