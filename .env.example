# Public project URL used by local clients and the Edge Function runtime.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-only key. Never expose this value to the Expo app or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-project-secret

# Server-only OpenAI key used by POST /analyze and POST /chat.
OPENAI_API_KEY=replace-with-openai-api-key

# Keep the tested vision model explicit so an alias change cannot alter results silently.
OPENAI_MODEL=gpt-4.1-mini-2025-04-14

# Optional chat-only override. If omitted, chat uses OPENAI_MODEL.
OPENAI_CHAT_MODEL=gpt-4.1-mini-2025-04-14

# A random value of at least 24 characters. The CSV importer sends this only to /analyze.
ANALYZE_ADMIN_TOKEN=replace-with-a-long-random-admin-token
