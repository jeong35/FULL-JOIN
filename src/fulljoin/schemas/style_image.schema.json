{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StyleImageAnalysis",
  "description": "추구미 앱: 스타일 피드 사진 한 장을 모델이 분석한 결과 (강의 3 산출물). 속성은 온톨로지 StyleImage.style과 Item을 따른다. Item.gap_status는 모델이 아니라 갭 분석 코드가 채우므로 이 스키마에 없다. slot별 kind·visual_fit 짝은 후처리에서 검사한다. 보기 목록의 근거는 src/fulljoin/prompts/parse_query.md 참조.",
  "type": "object",
  "properties": {
    "style": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "캐주얼",
          "미니멀",
          "러블리",
          "청순",
          "엘레강스",
          "시크",
          "스트릿",
          "레트로",
          "프레피",
          "스포티",
          "글램"
        ]
      },
      "maxItems": 2,
      "description": "사진 전체 코디의 분위기(스타일 키워드) 0~2개. 옷이 없으면 빈 목록. 피드에 올릴 때 팀이 확정하고 모델은 추천한다. 중복 값은 후처리에서 제거한다(OpenAI strict 모드는 uniqueItems를 지원하지 않음)"
    },
    "items": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/Item"
      },
      "description": "사진에 실제로 보이는 옷 아이템. 하나도 없으면 빈 목록 — 지어내지 않는다 (AC10)"
    }
  },
  "required": [
    "style",
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "Item": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "string",
          "enum": [
            "상의",
            "하의",
            "원피스",
            "아우터",
            "신발",
            "가방"
          ],
          "description": "부위. 원피스는 상의와 하의 자리를 한 벌로 채운다. 옷장 WardrobeItem.slot과 같은 목록 (AC1)"
        },
        "kind": {
          "type": "string",
          "enum": [
            "반소매티셔츠",
            "긴소매티셔츠",
            "민소매",
            "셔츠",
            "블라우스",
            "니트",
            "맨투맨",
            "후드",
            "데님팬츠",
            "슬랙스",
            "코튼팬츠",
            "조거팬츠",
            "숏팬츠",
            "레깅스",
            "미니스커트",
            "미디스커트",
            "롱스커트",
            "미니원피스",
            "미디원피스",
            "롱원피스",
            "점프수트",
            "카디건",
            "재킷",
            "레더재킷",
            "데님재킷",
            "점퍼",
            "후드집업",
            "야상",
            "플리스",
            "베스트",
            "트렌치코트",
            "코트",
            "숏패딩",
            "롱패딩",
            "경량패딩",
            "스니커즈",
            "로퍼",
            "플랫슈즈",
            "힐",
            "부츠",
            "샌들",
            "슬리퍼",
            "숄더백",
            "크로스백",
            "토트백",
            "백팩",
            "에코백",
            "클러치"
          ],
          "description": "종류. 해당 slot의 목록에서만 고른다 — slot과 kind의 짝은 후처리에서 검사한다"
        },
        "color": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "블랙",
            "화이트",
            "아이보리",
            "그레이",
            "차콜",
            "베이지",
            "브라운",
            "카키",
            "네이비",
            "블루",
            "스카이블루",
            "연청",
            "중청",
            "진청",
            "흑청",
            "민트",
            "그린",
            "레드",
            "와인",
            "핑크",
            "라벤더",
            "퍼플",
            "옐로우",
            "오렌지",
            "실버",
            "골드",
            "멀티",
            "기타",
            null
          ],
          "description": "색. 가려짐·조명·필터·해상도 때문에 판단할 수 없으면 null, 색은 보이지만 목록에 없으면 기타, 무늬나 여러 색이면 멀티. 연청·중청·진청·흑청은 데님 소재에만"
        },
        "visual_fit": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "슬림",
            "레귤러",
            "오버사이즈",
            "스키니",
            "일자",
            "와이드",
            "부츠컷",
            null
          ],
          "description": "사진에서 보이는 실루엣(실제 착용 핏이 아님). 상의·원피스·아우터·점프수트는 슬림·레귤러·오버사이즈, 긴 바지는 스키니·일자·와이드·부츠컷. 분명히 보일 때만 넣고 아니면 null. 숏팬츠·레깅스·스커트·신발·가방은 항상 null"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "전체",
            "일부",
            "판단불가"
          ],
          "description": "그 옷이 사진에 보이는 정도. 형태가 거의 다 보이면 전체, 잘리거나 가려져 일부만 보이면 일부, 옷인 것은 알지만 종류·색을 확신할 수 없으면 판단불가. 보이지 않는 옷은 items에 넣지 않는다"
        },
        "brand": {
          "type": [
            "string",
            "null"
          ],
          "description": "캡션이나 이미지 속 글자에 실제로 적힌 브랜드명. 근거가 없으면 null (AC2)"
        },
        "product_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "캡션이나 이미지 속 글자에 실제로 적힌 제품명. 근거가 없으면 null (AC2)"
        },
        "brand_source": {
          "type": "string",
          "enum": [
            "캡션",
            "이미지_글자",
            "없음"
          ],
          "description": "brand·product_name의 근거(모델 출력용). 근거가 없으면 없음. 쇼핑몰_상품정보·사용자_입력은 모델이 쓰지 않고 앱 데이터 계층에서 합친다(ontology Item.brand_source)"
        }
      },
      "required": [
        "slot",
        "kind",
        "color",
        "visual_fit",
        "visibility",
        "brand",
        "product_name",
        "brand_source"
      ],
      "additionalProperties": false
    }
  }
}
